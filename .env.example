# VibeShift AI - Environment Variables
# Copy this file to .env and insert your real API key if you want live LLM generation.
# If left empty, VibeShift AI will seamlessly use its intelligent built-in simulation engine.

# Google Gemini API Key (Recommended - Free Tier available at https://aistudio.google.com/)
GEMINI_API_KEY=

# Optional: OpenAI / Groq Compatible API
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
# OPENAI_MODEL=gpt-3.5-turbo

# Server Port
PORT=5000
